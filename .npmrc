# Registry
registry=https://registry.npmjs.org/

# Network timeouts (milliseconds)
# fetch-timeout: timeout for a single HTTP request
# fetch-retry-mintimeout / maxtimeout: per-retry timeouts
fetch-timeout=60000
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
fetch-retries=2

# Force IPv4 so Docker containers don't stall on IPv6 AAAA lookups
prefer-offline=false

# Do NOT run postinstall / prepare scripts for optionalDependencies
# (the platform-specific native binaries don't need them)
ignore-scripts=false

# Progress bars slow down CI/Docker logs; disable them
progress=false

# Suppress audit during ci (saves one extra network round-trip)
audit=false

# Suppress funding messages
fund=false
