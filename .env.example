# Hosted Supabase project settings (Project Settings > API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# These two values are public and are embedded in the browser bundle.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

APP_URL=https://abar3d.ir
# Server-only production merchant code. In panel sandbox mode, merchant "zibal" is used.
ZIBAL_MERCHANT=

# Server-only Telegram notification credentials.
TELEGRAM_BOT_TOKEN=
# One or more numeric chat IDs, separated by commas.
TELEGRAM_ADMIN_CHAT_IDS=

# Torob Product API v3 verification key. It is public (not a per-shop secret).
# Keep it on one line with escaped \n, or use literal newlines in the PEM.
TOROB_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAt6Mu4T0pBORY11W+QeM35UsmLO3vsf+6yKpFDEImFk0=\n-----END PUBLIC KEY-----
TOROB_TOKEN_VERSION=1
# Optional: leave empty to keep queueing events without sending them to Torob.
TOROB_WEBHOOK_TOKEN=
TOROB_WEBHOOK_URL=https://api.torob.com/update/webhook/v1/
TOROB_QUEUE_SECRET=
TOROB_ORDER_TRACKING_ENABLED=false
